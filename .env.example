# =============================================================================
# Frontend Environment Configuration (.env.example)
# =============================================================================

# 1. Backend Server API Configuration
# URL of your Express / Google Sheets backend server
VITE_API_BASE_URL=https://localhost:8081

# Request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT_MS=30000

# 2. Trip & Branding Defaults (Fallback when backend metadata is loading/offline)
VITE_DEFAULT_TRIP_TITLE=Trip Expense
VITE_DEFAULT_TRIP_SUBTITLE=Expense & Splitter
VITE_DEFAULT_TRIP_ICON=landscape

# 3. User & Locale Defaults
VITE_DEFAULT_ACTIVE_PERSON=Niraj
VITE_CURRENCY_SYMBOL=₹

# 4. UI Behavior & Cache Configuration
# Breakpoint for desktop mobile-gate in pixels (default: 768)
VITE_DESKTOP_BREAKPOINT=768

# Toast display duration in milliseconds (default: 2800)
VITE_TOAST_DURATION_MS=2800

# TanStack Query cache stale time in milliseconds (default: 60000)
VITE_QUERY_STALE_TIME_MS=60000
